    // Special door: leave the castle.
    if (selected.type === "exit") {
        State.variables.enteredFromPdd = 0;
        delete State.variables.currentPdd;

        Engine.play("CastleEntrance");
        return;
    }

    // Normal vocabulary door.
  // Remember direction when travelling chronologically.
if (selected.type === "previous") {
    State.variables.travelDirection = -1;
} else if (selected.type === "next") {
    State.variables.travelDirection = 1;
}

State.variables.enteredFromPdd = currentPdd;
State.variables.currentPdd = Number(selected.room.pdd);

Engine.play("TestMystRoom");
}); // Close the door-click handler

leftButton.prop("disabled", circularDoors.length < 2);
rightButton.prop("disabled", circularDoors.length < 2);

showWall();

// Wait for both chamber images to finish loading.
// Reveal when images are ready, with a safety timeout.

const backgroundImage = document.getElementById("myst-background");
const paintingImage = document.getElementById("myst-pdd-image");

function waitForImage(img) {
    if (!img || img.complete) {
        return Promise.resolve();
    }

    return new Promise(function (resolve) {
        img.addEventListener("load", resolve, { once: true });
        img.addEventListener("error", resolve, { once: true });
    });
}

// Never keep the visitor behind the curtain indefinitely.
await Promise.race([
    Promise.all([
        waitForImage(backgroundImage),
        waitForImage(paintingImage)
    ]),
    new Promise(function (resolve) {
        setTimeout(resolve, 1500);
    })
]);

$("#myst-loading-curtain").addClass("is-ready");

} catch (error) {
    console.error("Myst room error:", error);
    word.text("Error al cargar la sala");
    status.text(error.message || "Error al cargar las puertas.");

    // Open the curtain even when something goes wrong.
    $("#myst-loading-curtain").addClass("is-ready");
}

})()>>
