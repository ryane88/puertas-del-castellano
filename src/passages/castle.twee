resultBox.text("Has llegado al Prompt " + nextPrompt);


            if (prompt.prompt_type === "ending") {
                $("<p>")
                    .text("Has llegado al final del castillo.")
                    .appendTo(previewBox);
            }

        } catch (error) {
            console.error("Solo dice error:", error);
            resultBox.text(
                "No se pudo cargar el siguiente descubrimiento."
            );
        } finally {
            rollButton.prop("disabled", false);
        }
    });
})()>>
<</done>>






