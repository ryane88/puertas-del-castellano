            "/rest/v1/poemas?select=*" +
            "&fecha_publicacion=eq." + today +
            "&publicado=eq.true&limit=1";

        const response = await fetch(endpoint, {
            headers: { apikey: setup.supabase.key }
        });

        if (!response.ok) {
