            enterButton.prop("disabled", false);
        }

let isTurning = false;

function turnWall(direction) {

    if (circularDoors.length < 2 || isTurning) return;

    isTurning = true;

    const scene = $(".myst-scene-image");

    const turningRight = direction === "right";

    scene.css({
        "--turn-out": turningRight ? "-15%" : "15%",
        "--turn-in": turningRight ? "15%" : "-15%"
    });

    // Slide the current wall out.
    scene.addClass("myst-turning-out");

    setTimeout(function () {

        selectedIndex = turningRight
            ? (selectedIndex + 1) % circularDoors.length
            : (selectedIndex - 1 + circularDoors.length)
                % circularDoors.length;

        // Change the wall while invisible.
        scene.css("transition", "none");
        scene.removeClass("myst-turning-out");
        scene.addClass("myst-turning-in");

        showWall();

        // Allow the browser to register the new position.
        requestAnimationFrame(function () {
            requestAnimationFrame(function () {

                scene.css("transition", "");
                scene.removeClass("myst-turning-in");

                setTimeout(function () {
                    isTurning = false;
                }, 180);

            });
        });

    }, 180);
}

        leftButton.on("click", function () {
            turnWall("left");
        });

        rightButton.on("click", function () {
            turnWall("right");
        });

enterButton.on("click", function () {
   console.log("CASTLE DOOR CLICKED");
    if (!circularDoors.length) return;
    
if (setup.audio.enabled) {
    setup.doorSound.currentTime = 0;
    setup.doorSound.play().catch(function (error) {
        console.log("Door sound unavailable:", error);
    });
}  
    
meaningRoom = null;
meaningButton.prop("hidden", true);
meaningQuiz.prop("hidden", true);
meaningChoices.empty();
meaningFeedback.empty();
