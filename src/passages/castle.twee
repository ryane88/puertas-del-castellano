:: CastleEntrance {"position":"475,700","size":"100,100"}

<<nobr>>
<<castleDoorTitle "Palabra del Día">>
<div class="myst-room">
    <div class="myst-scene">
        <div class="myst-scene-label">
            LA ENTRADA DEL CASTILLO
        </div>

        <div class="myst-scene-image">


            <img
                id="entrance-image"
                src="images/pdd-placeholder.jpg"
                alt=""
                class="myst-pdd-painting"
            >
            <img
                src="images/myst-chamber-transparent0.png"
                alt="Entrada del castillo"
                class="myst-background"
            >
        </div>

        <div class="myst-controls">
            <span style="width:100%;text-align:center;">
                Una puerta. Una aventura.
            </span>
        </div>
    </div>

    <div class="myst-parchment">
        <div class="myst-kicker" id="entrance-kicker">
            Buscando la última palabra...
        </div>

        <h2 id="entrance-word"></h2>
        <p id="entrance-description"></p>

        <button type="button" id="entrance-enter" disabled>
            Entrar en el castillo
        </button>

        <p id="entrance-status"></p>
    </div>
</div>
<<castleDoorReturn>>
<</nobr>>

<<done>>
<<run (async function () {

    try {
        const latestPdd = Number(
            await setup.getLatestPublishedPdd()
        );

        if (!Number.isFinite(latestPdd) || latestPdd <= 0) {
            throw new Error("No hay palabras publicadas.");
        }

        const room = await setup.getRoom(latestPdd);

        if (!room) {
            throw new Error("No se encontró la última sala.");
        }

        $("#entrance-kicker").text("PDD " + room.pdd);
        $("#entrance-word").text(room.word);
        $("#entrance-description").text(room.description || "");

        $("#entrance-image")
            .off("error")
            .one("error", function () {
                $(this).off("error");
                this.src = "images/pdd-placeholder.jpg";
            })
            .attr("alt", room.word)
            .attr("src", "images/pdd" + room.pdd + ".jpg");

        $("#entrance-enter")
            .prop("disabled", false)
            .on("click", function () {

                State.variables.currentPdd = latestPdd;
                State.variables.enteredFromPdd = 0;
setup.audio.startMusic();
                Engine.play("TestMystRoom");
            });

    } catch (error) {
        console.error("Castle entrance error:", error);
        $("#entrance-status").text(
            "No se pudo abrir la entrada del castillo."
        );
    }

})()>>
<</done>>



:: Empieza {"position":"100,100","size":"100,100"}

<<nobr>>
<div class="castle-home">

    <div class="castle-home-welcome">
        <h2>¡Bienvenidos, aventureros, a Puertas del Castellano!</h2>
        <p>
            Tras estos muros os esperan palabras por descubrir,
            puertas misteriosas y caminos que conectan el español
            con la imaginación.
        </p>
        <p>
            Explorad a vuestro ritmo, disfrutad del viaje
            y recordad: cada palabra abre una nueva puerta.
        </p>
    </div>

    <div id="castle-wall">

    <section class="wall-window" id="wall-window" aria-label="Vista panorámica del muro">
      <div class="wall-track" id="wall-track"></div>
        <button id="enter-door" type="button" hidden>Entrar</button>
      <div class="edge-shade left" aria-hidden="true"></div>
      <div class="edge-shade right" aria-hidden="true"></div>
      <div class="wall-caption" aria-hidden="true">27 puertas · una sola muralla</div>
    </section>

    <nav class="travel-controls" aria-label="Navegación de prueba">
      <button class="travel-button" id="previous-door" type="button" aria-label="Puerta anterior">
        <span class="arrow">←</span> Anterior
      </button>
      <div class="selection" aria-live="polite" aria-atomic="true">
        <span class="selection-count" id="selection-count"></span>
        <strong class="selection-name" id="selection-name"></strong>
        <span class="selection-hint" id="selection-hint"></span>
      </div>
      <button class="travel-button" id="next-door" type="button" aria-label="Puerta siguiente">
        Siguiente <span class="arrow">→</span>
      </button>
    </nav>

    <div class="key-guide" aria-label="Atajos de teclado">
      <span><kbd>B</kbd> <span id="shortcut-B">Solo en el Castillo</span></span>
      <span><kbd>C</kbd> <span id="shortcut-C">Poemas</span></span>
      <span><kbd>D</kbd> <span id="shortcut-D">Palabra del Día</span></span>
      <span hidden><kbd>H</kbd> <span id="shortcut-H">Pasadizo de Hipervínculos</span></span>
      <span><kbd>L</kbd> <span id="shortcut-L">Pila de Letras</span></span>
      <span><kbd>O</kbd> <span id="shortcut-O">Palacio de Obras</span></span>
      <span><kbd>Q</kbd> <span id="shortcut-Q">Pruebas de Don Quijote</span></span>
      <span><kbd>T</kbd> <span id="shortcut-T">Puerta de prueba</span></span>
      <span><kbd>←</kbd><kbd>→</kbd> Recorrer el muro</span>
    </div>
    <p class="prototype-note" id="data-status" role="status">
      Cargando puertas…
    </p>
  
    </div>
</div>
<</nobr>>




:: PDD155 {"position":"930,80","size":"100,100"}
<div class="room-card">
<div class="pdd-kicker">PDD #155</div>
<h1>GOZAR</h1>
<div class="pdd-image"><img src="images/pdd155.jpg" alt="gozar" onerror="this.onerror=null;this.src='images/pdd-placeholder.jpg';"></div>
<p>Desde una ventana abierta llega música. Alguien ríe en el patio. No necesitas poseer el momento. Basta con vivirlo.</p>
<p><strong>gozar.</strong></p>
<div class="inscription">Todas las palabras, frases e ideas están conectadas. Solo tienes que encontrar el camino.</div>
<div class="paths">[[saborear->PDD49]] · [[sobremesa->PDD51]] · [[hacer buenas migas->PDD299]]</div>
<div class="castle-return">[[← Volver al castillo->Empieza]]</div>
</div>


