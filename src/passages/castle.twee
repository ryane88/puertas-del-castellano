:: TavernRoom
<<nobr>>
<<castleDoorTitle "Puerta de prueba">>
<div class="room-card pdt-tavern">
    <div class="pdt-intro">
        <div class="pdt-tavern-art pdt-illustration">
            <span id="pdt-art-fallback">Una luz cálida te recibe junto al fuego.</span>
            <img id="pdt-art" alt="Taberna medieval con una barra de madera y una chimenea" hidden>
        </div>
        <p><em>Entras en una antigua taberna. El fuego de la chimenea ilumina las paredes de piedra. Detrás de la barra, el tabernero levanta la mirada y te sonríe.</em></p>
        <p><strong>Baldomero:</strong> ¡Bienvenido a la Posada de los Cuentos! Soy Baldomero, el posadero. ¿Cómo te llamas y qué te trae por aquí?</p>
    </div>
    <div id="pdt-history" role="log" aria-label="Conversación con Baldomero"></div>
    <section id="pdt-potion" hidden aria-label="La poción de Baldomero">
        <p><strong>Baldomero:</strong> «Dos pociones, dos maneras de viajar: una aventura libre o una aventura gramatical. Tú eliges.»</p>
        <form id="pdt-potion-form">
            <label for="pdt-adventure-type">Elige tu poción</label>
            <select id="pdt-adventure-type">
                <option value="open">Aventura libre</option>
                <option value="grammar">Aventura gramatical</option>
            </select>
            <div id="pdt-grammar-options" hidden>
                <p id="pdt-catalog-status" role="status"></p>
                <label for="pdt-grammar-adventure">Elige una aventura gramatical</label>
                <select id="pdt-grammar-adventure" disabled></select>
                <p id="pdt-grammar-focus"></p>
                <button id="pdt-catalog-retry" type="button">Volver a cargar el catálogo</button>
            </div>
            <label for="pdt-player-name">Tu nombre en la aventura</label>
            <input id="pdt-player-name" type="text" maxlength="60" required>
            <label for="pdt-background">¿Qué te trae hasta aquí? (opcional)</label>
            <input id="pdt-background" type="text" maxlength="300">
            <button type="submit">Beber la poción</button>
            <button id="pdt-decline" type="button">Ahora no</button>
        </form>
    </section>
    <button id="pdt-reoffer" type="button" hidden>Preguntar por la poción</button>
    <p id="pdt-location" hidden></p>
    <form id="pdt-form">
        <label for="pdt-response">Tu mensaje</label>
        <textarea id="pdt-response" rows="3" maxlength="800" required></textarea>
        <p id="pdt-status" role="status"></p>
        <p id="pdt-error" role="alert"></p>
        <button type="submit">Hablar</button>
    </form>
    <p id="pdt-memory-status" role="status"></p>
    <button id="pdt-reset" type="button">Nueva conversación</button>
    <button id="pdt-finish" type="button" hidden>Terminar la aventura</button>
</div>
<<castleDoorReturn>>
<</nobr>>

<<done>>
<<run (() => {
    const room = document.querySelector(".pdt-tavern");
    if (!room) return;
    const form = room.querySelector("#pdt-form");
    const response = room.querySelector("#pdt-response");
    const status = room.querySelector("#pdt-status");
    const error = room.querySelector("#pdt-error");
    const history = room.querySelector("#pdt-history");
    const submit = form.querySelector("button");
    const reset = room.querySelector("#pdt-reset");
    const memoryStatus = room.querySelector("#pdt-memory-status");
    const potion = room.querySelector("#pdt-potion");
    const potionForm = room.querySelector("#pdt-potion-form");
    const name = room.querySelector("#pdt-player-name");
    const adventureType = room.querySelector("#pdt-adventure-type");
    const grammarOptions = room.querySelector("#pdt-grammar-options");
    const grammarSelect = room.querySelector("#pdt-grammar-adventure");
    const grammarFocus = room.querySelector("#pdt-grammar-focus");
    const catalogStatus = room.querySelector("#pdt-catalog-status");
    const catalogRetry = room.querySelector("#pdt-catalog-retry");
    const drink = potionForm.querySelector('button[type="submit"]');
    let catalog = [];
    let catalogLoading = false;
    const background = room.querySelector("#pdt-background");
    const decline = room.querySelector("#pdt-decline");
    const reoffer = room.querySelector("#pdt-reoffer");
    const location = room.querySelector("#pdt-location");
    const finish = room.querySelector("#pdt-finish");
    const v = State.variables;
    const lifetime = new AbortController();
    $(document).one(":passageinit", () => lifetime.abort());

    // Convert the original one-turn introduction when opening an older save.
    if (!Array.isArray(v.pdtConversation)) {
        v.pdtConversation = v.pdtIntroCompleted && v.pdtResponse
            ? [
                { role: "user", content: v.pdtResponse },
                { role: "assistant", content: "¡Muchas gracias, aventurero! Espero que encuentres lo que buscas en tu viaje. Descansa un poco. Aquí siempre tendrás un lugar junto al fuego." }
            ]
            : [];
    }

    function appendMessage(message, active, isLatest, illustrationSide) {
        const line = document.createElement("p");
        if (active && message.role === "assistant") {
            if (illustrationSide) {
                line.className = "pdt-illustrated-reply";
                const image = document.createElement("img");
                image.className = "pdt-illustration pdt-illustration-" + illustrationSide;
                image.alt = message.image.altText;
                image.loading = "lazy";
                image.addEventListener("error", () => image.remove(), { once: true });
                image.src = message.image.path;
                line.append(image);
            }
            const narration = document.createElement("em");
            narration.textContent = message.content;
            if (isLatest) {
                const emphasis = document.createElement("strong");
                emphasis.append(narration);
                line.append(emphasis);
            } else {
                line.append(narration);
            }
        } else {
            const speaker = document.createElement("strong");
            speaker.textContent = message.role === "user" ? "Tú:" : "Baldomero:";
            line.append(speaker, " " + message.content);
        }
        history.append(line);
    }

    const restored = setup.tavernMemory.restore(v.pdtConversation);
    v.pdtConversation = restored.messages;
    const restoredAdventure = setup.tavernAdventureMemory.restore({ status: "not_started" });
    v.pdtAdventure = restoredAdventure.messages;
    memoryStatus.textContent = restoredAdventure.warning || restored.warning;

    let offerDismissed = v.pdtAdventure.potionDeclined === true || v.pdtAdventure.status === "completed";
    let offerReady = v.pdtAdventure.potionOffered === true || v.pdtConversation.length >= 8;
    let busy = false;
    const isActive = () => v.pdtAdventure.status === "active";
    const isCurrent = () => !lifetime.signal.aborted && room.isConnected && State.variables === v;

    function render() {
        const active = isActive();
        history.replaceChildren();
        history.setAttribute("aria-label", active ? "Diálogo de la aventura" : "Conversación con Baldomero");
        const messages = active ? v.pdtAdventure.dialogue : v.pdtConversation;
        let illustrationCount = 0;
        messages.forEach((message, index) => {
            const side = active && message.role === "assistant" && setup.isTavernSceneImage(message.image)
                ? (illustrationCount++ % 2 === 0 ? "right" : "left") : undefined;
            appendMessage(message, active, index === messages.length - 1, side);
        });
        location.hidden = !active;
        location.textContent = active ? "Lugar: " + v.pdtAdventure.location +
            (v.pdtAdventure.situation ? " · " + v.pdtAdventure.situation : "") : "";
        submit.textContent = active ? "Actuar" : "Hablar";
        reset.hidden = active;
        finish.hidden = !active;
        potion.hidden = active || !offerReady || offerDismissed;
        reoffer.hidden = active || !offerDismissed;
    }

    function updateCatalogControls() {
        const grammar = adventureType.value === "grammar";
        grammarOptions.hidden = !grammar;
        grammarSelect.disabled = busy || catalogLoading || !catalog.length;
        catalogRetry.disabled = busy || catalogLoading;
        drink.disabled = busy || (grammar && (catalogLoading || !catalog.length));
        const selected = catalog.find(entry => entry.slug === grammarSelect.value);
        grammarFocus.textContent = selected ? selected.grammar_focus + " " + selected.premise : "";
    }

    async function loadCatalog() {
        if (busy || catalogLoading) return;
        catalogLoading = true;
        catalogStatus.textContent = "Cargando aventuras…";
        updateCatalogControls();
        try {
            const entries = await setup.getGrammarAdventures(lifetime.signal);
            if (!isCurrent()) return;
            catalog = entries;
            grammarSelect.replaceChildren();
            for (const entry of entries) {
                const option = document.createElement("option");
                option.value = entry.slug;
                option.textContent = entry.title;
                grammarSelect.append(option);
            }
            catalogStatus.textContent = entries.length ? "" :
                "No hay aventuras gramaticales disponibles. Puedes elegir Aventura libre.";
        } catch {
            if (isCurrent()) catalogStatus.textContent =
                "No se pudo cargar el catálogo. Vuelve a intentarlo o elige Aventura libre.";
        } finally {
            catalogLoading = false;
            if (isCurrent()) updateCatalogControls();
        }
    }

    adventureType.addEventListener("change", () => {
        updateCatalogControls();
        if (adventureType.value === "grammar" && !catalog.length) loadCatalog();
    });
    catalogRetry.addEventListener("click", loadCatalog);
    grammarSelect.addEventListener("change", updateCatalogControls);

    function setBusy(value) {
        busy = value;
        submit.disabled = reset.disabled = finish.disabled = reoffer.disabled = value;
        for (const field of potionForm.elements) field.disabled = value;
        response.readOnly = value;
        updateCatalogControls();
    }

    render();
    updateCatalogControls();

    reset.addEventListener("click", async () => {
        if (busy || isActive() || !window.confirm("¿Quieres borrar esta conversación e iniciar otra?")) return;
        setBusy(true);
        try {
            const warning = await setup.tavernMemory.save([], true);
            if (lifetime.signal.aborted || State.variables !== v) return;
            memoryStatus.textContent = warning;
            if (warning) return;
            v.pdtConversation = [];
            offerReady = false;
            render();
            response.value = "";
            error.textContent = "";
            response.focus();
        } finally {
            setBusy(false);
        }
    });

    const art = room.querySelector("#pdt-art");
    art.addEventListener("load", () => {
        art.hidden = false;
        room.querySelector("#pdt-art-fallback").hidden = true;
    }, { once: true });
    art.src = "images/pdt-tavern.jpg";

    async function playTurn(message, adventure) {
        setBusy(true);
        error.textContent = "";
        status.textContent = adventure ? "La aventura continúa…" : "Baldomero está pensando…";
        try {
            const messages = adventure ? adventure.dialogue : v.pdtConversation;
            const context = adventure ? setup.getTavernAdventureContext(adventure) : undefined;
            const introducePotion = !adventure && !offerReady && !offerDismissed &&
                (messages.length >= 6 || /\bpoci[oó]n\b/i.test(message.content));
            const result = await setup.getBaldomeroReply(
                [...messages, message],
                AbortSignal.any([lifetime.signal, AbortSignal.timeout(25000)]),
                context,
                introducePotion
            );
            if (!isCurrent()) return;

            const answer = { role: "assistant", content: adventure ? result.reply : result };
            if (adventure && setup.isTavernSceneImage(result.sceneImage)) answer.image = result.sceneImage;
            const dialogue = [...messages, message, answer];
            let save;
            if (adventure) {
                const scene = result.adventure;
                v.pdtAdventure = {
                    ...context,
                    ...scene,
                    id: adventure.id,
                    playerName: adventure.playerName,
                    background: adventure.background ?? "",
                    adventureType: adventure.adventureType ?? "open",
                    ...(adventure.adventureType === "grammar" ? {
                        grammarAdventure: adventure.grammarAdventure,
                        puzzleState: scene.puzzleState
                    } : {}),
                    mode: "adventure",
                    status: "active",
                    dialogue
                };
                save = setup.tavernAdventureMemory.save(v.pdtAdventure);
            } else {
                v.pdtConversation = dialogue;
                save = setup.tavernMemory.save(dialogue);
                if (introducePotion) {
                    offerReady = true;
                    v.pdtAdventure = { ...v.pdtAdventure, mode: "tavern", potionOffered: true };
                    const offerSave = setup.tavernAdventureMemory.save(v.pdtAdventure);
                    save = Promise.all([save, offerSave]).then(warnings => warnings.find(Boolean));
                }
            }

            render();
            response.value = "";
            status.textContent = "";
            memoryStatus.textContent = (await save) || "";
        } catch (failure) {
            if (isCurrent()) {
                error.textContent = failure.message === "La posada está muy concurrida. Inténtalo más tarde."
                    ? failure.message
                    : "No se pudo continuar. Inténtalo de nuevo.";
            }
        } finally {
            status.textContent = "";
            setBusy(false);
            if (isCurrent() && (!adventure || isActive())) response.focus();
        }
    }

    decline.addEventListener("click", async () => {
        offerDismissed = true;
        v.pdtAdventure = { ...v.pdtAdventure, mode: "tavern", potionDeclined: true };
        const save = setup.tavernAdventureMemory.save(v.pdtAdventure);
        render();
        response.focus();
        const warning = await save;
        if (isCurrent()) memoryStatus.textContent = warning;
    });

    reoffer.addEventListener("click", () => {
        offerDismissed = false;
        offerReady = true;
        potion.hidden = false;
        reoffer.hidden = true;
        name.focus();
    });

    potionForm.addEventListener("submit", (event) => {
        event.preventDefault();
        if (busy || isActive()) return;
        const selectedGrammar = catalog.find(entry => entry.slug === grammarSelect.value);
        if (adventureType.value === "grammar" && (catalogLoading || !selectedGrammar)) {
            catalogStatus.textContent = "Selecciona una aventura o elige Aventura libre.";
            return;
        }
        const playerName = name.value.trim();
        if (!playerName) {
            name.focus();
            return;
        }
        if (v.pdtAdventure.status === "completed" &&
            !window.confirm("¿Quieres reemplazar la aventura terminada por una nueva?")) return;

        return playTurn({ role: "user", content: "Acepto y bebo la poción de Baldomero." }, {
            id: crypto.randomUUID(),
            adventureType: adventureType.value,
            ...(adventureType.value === "grammar" ? {
                grammarAdventure: selectedGrammar,
                puzzleState: { turnsSincePuzzle: 0, pending: null }
            } : {}),
            playerName,
            background: background.value.trim(),
            status: "not_started",
            location: "La Posada de los Cuentos",
            summary: "",
            characters: [],
            inventory: [],
            dialogue: []
        });
    });

    finish.addEventListener("click", async () => {
        if (busy || !isActive() || !window.confirm("¿Quieres terminar la aventura y volver a hablar con Baldomero?")) return;
        setBusy(true);
        try {
            const completed = { ...v.pdtAdventure, mode: "tavern", status: "completed" };
            const warning = await setup.tavernAdventureMemory.save(completed);
            if (!isCurrent()) return;
            v.pdtAdventure = completed;
            offerDismissed = true;
            memoryStatus.textContent = warning;
            response.value = "";
            render();
        } finally {
            setBusy(false);
        }
    });

    form.addEventListener("submit", (event) => {
        event.preventDefault();
        if (busy) return;
        const content = response.value.trim();
        if (!content) {
            error.textContent = "Escribe un mensaje antes de continuar.";
            response.focus();
            return;
        }
        return playTurn({ role: "user", content }, isActive() ? v.pdtAdventure : undefined);
    });
})()>>
<</done>>


:: PruebasDonQuijote
<<nobr>>
