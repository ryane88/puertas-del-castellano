);

// Close the chronological loop in both directions.
if (currentPdd === 1 && !previous && latestNumber > 1) {
    previous = await setup.getRoom(latestNumber);
}

if (currentPdd === latestNumber && !next && latestNumber > 1) {
    next = await setup.getRoom(1);
}

// Connect PDD 1 backward to the latest published PDD.
if (!previous && currentPdd === 1) {
    const latestNumber = Number(
        await setup.getLatestPublishedPdd()
    );

    if (latestNumber > 1) {
        previous = await setup.getRoom(latestNumber);
    }
}

        const enteredFromPdd =
            Number(State.variables.enteredFromPdd || 0);

        // Avoid duplicate chronological and semantic doors.

        const semanticDoors = availableDoors.filter(function (item) {
            return Number(item.room.pdd) !== Number(previous?.pdd)
                && Number(item.room.pdd) !== Number(next?.pdd);
        });

        // Set aside the entrance door, if present.

        const returnIndex = semanticDoors.findIndex(function (item) {
            return Number(item.room.pdd) === enteredFromPdd;
        });

        const returnDoor = returnIndex >= 0
            ? semanticDoors.splice(returnIndex, 1)[0]
            : null;

       // CHRONOLOGICAL HALLWAY
// The door ahead continues our direction of travel.

const circularDoors = [];

const latestPdd = Number(
    await setup.getLatestPublishedPdd()
);

// Determine which chronological direction we are travelling.
// -1 = toward older PDDs
// +1 = toward newer PDDs

const travelDirection =
    Number(State.variables.travelDirection) || -1;

// Chronological doors
const olderDoor = previous
    ? { room: previous, type: "previous" }
    : null;

const newerDoor = next
    ? { room: next, type: "next" }
    : null;

// The forward-facing door always continues our journey.
// At the beginning of the timeline, continue toward newer PDDs.
const effectiveDirection = travelDirection;

const forwardDoor =
    effectiveDirection === -1 ? olderDoor : newerDoor;

const backwardDoor =
    effectiveDirection === -1 ? newerDoor : olderDoor;

// Put the forward door first.
if (forwardDoor) {
    circularDoors.push(forwardDoor);
}

// Semantic doors occupy the sides of the chamber.
const midpoint = Math.ceil(semanticDoors.length / 2);

circularDoors.push(...semanticDoors.slice(0, midpoint));

// Preserve a semantic return door.
if (returnDoor) {
    circularDoors.push(returnDoor);
}

circularDoors.push(...semanticDoors.slice(midpoint));

// The chronological door behind us.
if (backwardDoor) {
    circularDoors.push(backwardDoor);
}

// The castle exit is behind the visitor in the latest PDD.
// The first vocabulary door is behind the visitor
// when standing in the latest PDD.


// Initially face the forward chronological door.
let selectedIndex = 0;
function showWall() {
console.log(
    "HALLWAY DEBUG",
