                (isTimeDoor ? " · Puerta del Tiempo" : "")
            );

            // Hide the word until the player clicks it.
word.stop(true, true)
    .text("¿Qué palabra soy?")
    .css("cursor", "pointer")
    .attr("title", "Revelar palabra")
    .off("click.pddReveal")
