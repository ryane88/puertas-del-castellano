});

    const counter = $("#myst-counter");
    const status = $("#myst-status");
    const enterButton = $("#myst-enter");
    
    const doorHotspot = $("#myst-door-hotspot");

doorHotspot.on("click", function () {
    if (!enterButton.prop("disabled")) {
        enterButton.trigger("click");
    }
});
    

    const leftButton = $("#myst-left");
    const rightButton = $("#myst-right");
const audioButton = $("#myst-audio-toggle");

function updateAudioButton() {
