:: StoryScript [script]

/* PUERTAS DEL CASTELLANO — SUPABASE */

setup.supabase = {
    url: "https://piqrpkzahyjkoytdycdg.supabase.co",
    key: "sb_publishable_o8s0h6t3P60zn5hLPrtL5Q_hIVrzv_x"
};

setup.getRoom = async function (pdd) {
    const endpoint =
        setup.supabase.url +
        "/rest/v1/rooms?select=*&pdd=eq." +
        encodeURIComponent(pdd);

    const response = await fetch(endpoint, {
        headers: {
            apikey: setup.supabase.key
        }
    });

    if (!response.ok) {
        throw new Error("Supabase error: " + response.status);
    }

    const rooms = await response.json();
    return rooms[0] || null;
};

/* PUERTAS DEL CASTELLANO — CHAPTER LOOKUP */

setup.getChapter = async function (chapterId) {
    const endpoint =
        setup.supabase.url +
        "/rest/v1/chapters?select=*&id=eq." +
        encodeURIComponent(chapterId);

    const response = await fetch(endpoint, {
        headers: {
            apikey: setup.supabase.key
        }
    });

    if (!response.ok) {
        throw new Error("Chapter lookup error: " + response.status);
    }

    const chapters = await response.json();
    return chapters[0] || null;
};

/* PUERTAS DEL CASTELLANO — ROOM CONNECTIONS */

setup.getConnections = async function (pdd) {
    const endpoint =
        setup.supabase.url +
        "/rest/v1/room_connections" +
        "?select=*" +
        "&enabled=eq.true" +
        "&or=(from_pdd.eq." + encodeURIComponent(pdd) +
        ",to_pdd.eq." + encodeURIComponent(pdd) + ")";

    const response = await fetch(endpoint, {
        headers: {
            apikey: setup.supabase.key
        }
    });

    if (!response.ok) {
        throw new Error(
            "Connections error: " + response.status
        );
    }

    return await response.json();
};

/* PUERTAS DEL CASTELLANO — PUBLISHED ROOMS */

setup.getPublishedRooms = async function (pddNumbers) {
    if (!pddNumbers.length) {
        return [];
    }

const endpoint =
    setup.supabase.url +
    "/rest/v1/rooms?select=*" +
    "&published=eq.true" +
    "&pdd=in.(" +
    pddNumbers.map(Number).join(",") +
    ")";
console.log("PUBLISHED ROOMS URL:", endpoint);
    const response = await fetch(endpoint, {
        headers: {
            apikey: setup.supabase.key
        }
    });

    if (!response.ok) {
        throw new Error(
            "Published rooms error: " + response.status
        );
    }

    return await response.json();
};


/* PUERTAS DEL CASTELLANO — NEIGHBOURS */
setup.getChronologicalNeighbors = async function(currentPdd) {
    const base = setup.supabase.url + "/rest/v1/rooms";
    const headers = {
        apikey: setup.supabase.key
    };

    async function findNeighbor(operator, direction) {
        const endpoint = base
            + "?select=pdd,word,title,description"
            + "&published=eq.true"
            + "&pdd=" + operator + "." + Number(currentPdd)
            + "&order=pdd." + direction
            + "&limit=1";

        const response = await fetch(endpoint, { headers });

        if (!response.ok) {
            throw new Error("Chronological neighbor error: " + response.status);
        }

        const rooms = await response.json();
        return rooms[0] || null;
    }

    const [previous, next] = await Promise.all([
        findNeighbor("lt", "desc"),
        findNeighbor("gt", "asc")
    ]);

    return { previous, next };
};

/* PUERTAS DEL CASTELLANO — LATESTPUBLISHED*/
setup.getLatestPublishedPdd = async function () {
    const endpoint = setup.supabase.url
        + "/rest/v1/rooms"
        + "?select=pdd"
        + "&published=eq.true"
        + "&order=pdd.desc"
        + "&limit=1";

    const response = await fetch(endpoint, {
        headers: {
            apikey: setup.supabase.key
        }
    });

    if (!response.ok) {
        throw new Error("Latest PDD lookup failed: " + response.status);
    }

    const rooms = await response.json();

    return rooms.length ? Number(rooms[0].pdd) : null;
};

/* PUERTAS DEL CASTELLANO — DIRECT LINK SESSION PRIORITY */

$(document).one(":storyready", function () {
    const pdd = new URLSearchParams(window.location.search).get("pdd");

    if (!pdd) return;

    (async function () {
        let destination = null;

        if (pdd === "today") {
            destination = await setup.getLatestPublishedPdd();
        } else if (/^\d+$/.test(pdd) && Number(pdd) > 0) {
            destination = Number(pdd);
        }

        if (destination === null) return;

        State.variables.currentPdd = destination;
        State.variables.enteredFromPdd = 0;

        Engine.play("TestMystRoom");
    })().catch(function (error) {
        console.error("Direct PDD link error:", error);
    });
});
/* PUERTAS DEL CASTELLANO — MANUSCRIPT INTERACTION */

$(document).on("click", "#pdd-open-manuscript", function () {
    $("#pdd-manuscript-overlay").prop("hidden", false);
});

$(document).on("click", "#pdd-close-manuscript", function () {
    $("#pdd-manuscript-overlay").prop("hidden", true);
});

$(document).on("click", "#pdd-manuscript-overlay", function (event) {
    if (event.target === this) {
        $(this).prop("hidden", true);
    }
});
/* PUERTAS DEL CASTELLANO — MANUSCRIPT WORD NAVIGATION */

$(document).on("click", ".pdd-manuscript-word", function (event) {
    event.preventDefault();

    const destination = Number($(this).attr("data-pdd"));

    if (!destination) return;

    State.variables.enteredFromPdd =
        Number(State.variables.currentPdd || 0);

    State.variables.currentPdd = destination;

    Engine.play("TestMystRoom");
});
Config.ui.stowBarInitially = true;

/* PUERTAS DEL CASTELLANO — AUDIO */
/* Preload the door creak */
setup.doorSound = new Audio("audio/door-open.wav");
setup.doorSound.preload = "auto";
setup.doorSound.load();

setup.audio = setup.audio || {};
setup.audio.enabled = true;
setup.audio.music = setup.audio.music || new Audio("audio/chamber0.mp3");

setup.audio.startMusic = function (chamberNumber) {
    if (!setup.audio.enabled) return;

    const number = Number(chamberNumber) || 0;
    const path = "audio/chamber" + number + ".mp3";

    if (setup.audio.music.getAttribute("src") !== path) {
        setup.audio.music.pause();
        setup.audio.music.src = path;
        setup.audio.music.load();
    }

    setup.audio.music.loop = true;
    setup.audio.music.volume = 0.25;

    setup.audio.music.play().catch(function (error) {
        console.log("Music playback unavailable:", error);
    });
};

:: StoryStylesheet [stylesheet]

/* PUERTAS DEL CASTELLANO — LIGHT THEME */

body {
  background: #E8DDC8;
  color: #514839;
  font-family: Georgia, serif;
}

#passages {
  max-width: 900px;
}

h1, h2 {
  color: #514839;
  text-align: center;
  letter-spacing: 0.06em;
}

/* Main room panel */
.room-card {
  padding: 1.4rem 1.6rem;
  border: 1px solid #B7A585;
  border-radius: 12px;
  background: rgba(245, 235, 217, 0.96);
  box-shadow: 0 4px 18px rgba(81, 72, 57, 0.10);
}

/* PDD number */
.pdd-kicker {
  text-align: center;
  color: #8B6B3F;
  font-size: 0.9em;
  letter-spacing: 0.12em;
}


/* PDD PAINTING FRAMES */

.pdd-image {
  margin: 1.5rem auto 2rem;
  max-width: 720px;
  aspect-ratio: 4 / 3;
  box-sizing: border-box;
  overflow: hidden;

  border: 9px ridge #8B6B3F;
  border-radius: 2px;

  box-shadow: 0 8px 16px rgba(50,35,20,0.3);
}

.pdd-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Dark walnut */
.pdd-image.frame-0 {
  border-color: #65452F;
  background: #493021;
}

/* Antique bronze */
.pdd-image.frame-1 {
  border-color: #A3834D;
  background: #725733;
}

/* Weathered oak */
.pdd-image.frame-2 {
  border-color: #9A7854;
  background: #6F563E;
}

/* Castle inscription */
.inscription {
  margin-top: 1.8rem;
  padding-top: 1rem;
  border-top: 1px solid #C9B99A;
  color: #76634A;
  font-style: italic;
  text-align: center;
}

/* Semantic corridors */

/* SEMANTIC CORRIDORS — MEDIEVAL DOORS */

.paths {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: stretch;
  gap: 0.8rem;
  margin: 1.5rem 0;
}

.paths a {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 100px;
  min-height: 145px;
  box-sizing: border-box;
  padding: 0.8rem;

  background: #D9C6A4;
  color: #514839;

  border: 3px solid #8B6B3F;
  border-radius: 4px;

  text-align: center;
  text-decoration: none;
  font-weight: bold;
  font-size: 0.9rem;
  line-height: 1.3;
  overflow-wrap: anywhere;

  box-shadow: inset 0 0 0 3px #E8DDC8,
              2px 4px 6px rgba(81,72,57,0.2);

  transition: background 0.2s, transform 0.2s;
}

.paths a:hover {
  background: #B8C4AF;
  color: #514839;
  transform: translateY(-4px);
}



/* Return to castle */
.castle-return {
  margin-top: 2rem;
  text-align: center;
  font-size: 0.9em;
}

/* SugarCube links */
a, .link-internal {
  color: #647568;
}

a:hover, .link-internal:hover {
  color: #8B6B3F;
}


/* PDD — Return door */
#test-connections a.return-door {
    display: flex !important;
    visibility: visible !important;
    grid-column: 1 / -1;
    width: 100%;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    white-space: normal;
    margin-top: 12px;
    box-sizing: border-box;
}


/* Chronological doors — Las Puertas del Tiempo */
#circular-door.time-door {
    background: linear-gradient(
        135deg,
        #a68a55,
        #6f542c,
        #47351f
    ) !important;

    border-color: #d4b46c !important;
    color: #fff0c7 !important;

    box-shadow:
        inset 0 0 22px rgba(255, 215, 130, 0.18),
        0 0 16px rgba(183, 139, 55, 0.22);
}

/* Circular room — 3D turning effect */

#circular-content {
    perspective: 1100px;
    perspective-origin: center center;
}

#circular-content .turn-wall {
    transform-style: preserve-3d;
    backface-visibility: hidden;
    will-change: transform, opacity;
}

@keyframes castle-turn-out-left {
    from {
        transform: rotateY(0deg);
        opacity: 1;
    }
    to {
        transform: rotateY(-55deg) translateX(45px);
        opacity: 0;
    }
}

@keyframes castle-turn-in-left {
    from {
        transform: rotateY(55deg) translateX(-45px);
        opacity: 0;
    }
    to {
        transform: rotateY(0deg);
        opacity: 1;
    }
}

@keyframes castle-turn-out-right {
    from {
        transform: rotateY(0deg);
        opacity: 1;
    }
    to {
        transform: rotateY(55deg) translateX(-45px);
        opacity: 0;
    }
}

@keyframes castle-turn-in-right {
    from {
        transform: rotateY(-55deg) translateX(45px);
        opacity: 0;
    }
    to {
        transform: rotateY(0deg);
        opacity: 1;
    }
}

#circular-content.turn-out-left {
    animation: castle-turn-out-left 220ms ease-in forwards;
}

#circular-content.turn-in-left {
    animation: castle-turn-in-left 280ms ease-out both;
}

#circular-content.turn-out-right {
    animation: castle-turn-out-right 220ms ease-in forwards;
}

#circular-content.turn-in-right {
    animation: castle-turn-in-right 280ms ease-out both;
}

@media (prefers-reduced-motion: reduce) {
    #circular-content.turn-out-left,
    #circular-content.turn-in-left,
    #circular-content.turn-out-right,
    #circular-content.turn-in-right {
        animation: none;
    }
}
/* PUERTAS DEL CASTELLANO — MANUSCRIPT OVERLAY */

#pdd-manuscript-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(12, 9, 5, 0.82);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
}

#pdd-manuscript-overlay[hidden] {
    display: none;
}

#pdd-manuscript-paper {
    position: relative;
    width: min(720px, 100%);
    max-height: 85vh;
    overflow-y: auto;
    padding: 48px 55px;
    box-sizing: border-box;
    background: linear-gradient(135deg, #f1dfb5, #d9bd83);
    border: 9px double #8a6534;
    box-shadow: 0 18px 65px rgba(0, 0, 0, 0.7);
    color: #382513;
    font-family: Georgia, serif;
    line-height: 1.8;
}

#pdd-manuscript-paper h2 {
    color: #59341c;
    text-align: center;
}

.pdd-manuscript-heading {
    text-align: center;
    letter-spacing: 3px;
    font-size: 0.85em;
    color: #805b32;
}

#pdd-close-manuscript {
    position: absolute;
    top: 12px;
    right: 14px;
    background: transparent;
    border: none;
    color: #59341c;
    font-size: 1.5em;
    cursor: pointer;
}
/* PUERTAS DEL CASTELLANO — MANUSCRIPT VOCABULARY LINKS */

.pdd-manuscript-word {
    color: #7a321b;
    font-weight: bold;
    text-decoration: underline dotted;
    text-underline-offset: 4px;
    cursor: pointer;
}

.pdd-manuscript-word:hover {
    color: #ad5b24;
    text-decoration-style: solid;
}
/* PUERTAS DEL CASTELLANO — MYST ROOM PROTOTYPE */

/* =========================================================
   PUERTAS DEL CASTELLANO — MYST ROOM PROTOTYPE
   Isolated styling for TestMystRoom
   ========================================================= */

.myst-room {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
}

/* PUERTAS DEL CASTELLANO — MYST CHAMBER */

.myst-scene {
    background: #21170f;
    border: 5px solid #705333;
    border-radius: 12px 12px 0 0;
    overflow: hidden;
}

.myst-scene-label {
    padding: 12px;
    color: #e8d2a6;
    font-size: 0.75rem;
    letter-spacing: 2px;
    text-align: center;
}

/* PUERTAS DEL CASTELLANO — IMAGE LAYERS */

.myst-scene-image {
    position: relative;
    display: block;
    width: 100%;
    min-height: 0;
    aspect-ratio: auto;
    background: #21170f;
}

/* Castle foreground, including gold frame */

.myst-background {
    position: relative;
    z-index: 2;
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
}

/* PDD artwork behind transparent opening */

.myst-pdd-painting {
    position: absolute;
    z-index: 1;

left: 56.85%;
top: 28.8%;
width: 25.3%;
height: 26.4%;
object-fit: cover;

 
    border: none;
    transform: none;
    box-sizing: border-box;
}

/* PUERTAS DEL CASTELLANO — NAVIGATION */

.myst-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px;
    color: #e8d2a6;
    gap: 12px;
}

.myst-controls button {
    min-width: 48px;
    min-height: 48px;
    font-size: 1.3rem;
}

.myst-controls span {
    text-align: center;
    font-size: 0.85rem;
}

/* PUERTAS DEL CASTELLANO — PARCHMENT */

.myst-parchment {
    background: linear-gradient(135deg, #f1dfb5, #d9bd83);
    border: 5px solid #705333;
    border-top: none;
    border-radius: 0 0 12px 12px;
    padding: 24px;
    color: #382513;
    font-family: Georgia, serif;
}

.myst-parchment h2 {
    color: #59341c;
    margin: 8px 0;
}

.myst-kicker {
    font-size: 0.75rem;
    letter-spacing: 2px;
    color: #805b32;
}

/* PUERTAS DEL CASTELLANO — DESKTOP */

@media (min-width: 700px) {
    .myst-parchment {
        padding: 32px 48px;
    }
}
/* PUERTAS DEL CASTELLANO — MYST LAYER ISOLATION */

.myst-scene-image {
    isolation: isolate;
}

.myst-background {
    position: relative;
    z-index: 2;
}

.myst-pdd-painting {
  
    position: absolute;
    z-index: 1;
}
/* Mirror the chamber when the destination PDD is odd */
.myst-scene-image.myst-mirrored .myst-background {
    transform: scaleX(-1);
}

/* Move the PDD painting to the opposite side.
   The painting itself stays readable. */
.myst-scene-image.myst-mirrored .myst-pdd-painting {
    left: 17.85%;
}
/* Camera-style turning between doors */

.myst-scene-image {
    transition:
        opacity 180ms ease-in-out,
        transform 180ms ease-in-out;
}

.myst-scene-image.myst-turning-out {
    opacity: 0;
    transform: translateX(var(--turn-out, -15%));
}

.myst-scene-image.myst-turning-in {
    opacity: 0;
    transform: translateX(var(--turn-in, 15%));
}
.myst-scene-image {
    position: relative;
}

.myst-door-hotspot {
    position: absolute;
    z-index: 5;

    /* Approximate wooden door position */
    left: 8%;
    top: 32%;
    width: 28%;
    height: 39%;

    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    cursor: pointer;
}

/* Move hotspot when chamber is mirrored */
.myst-scene-image.myst-mirrored .myst-door-hotspot {
    left: auto;
    right: 8%;
}

/* Subtle indication that the door is interactive */
.myst-door-hotspot:hover {
    background: rgba(255, 215, 120, 0.08);
}

.myst-door-hotspot:focus-visible {
    outline: 2px solid gold;
}
/* PUERTAS DEL CASTELLANO — ROOM TRANSITION */

.myst-room {
    position: relative;
}

#myst-loading-curtain {
    position: absolute;
    inset: 0;
    z-index: 100;
    background: #100d0b;
    color: #c9ad75;

    display: flex;
    align-items: center;
    justify-content: center;

    font-family: Georgia, serif;
    font-size: 1.15rem;
    font-style: italic;
    letter-spacing: 0.06em;

    opacity: 1;
    visibility: visible;
    transition: opacity 0.65s ease, visibility 0.65s ease;
}

#myst-loading-curtain.is-ready {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}
/* PDD — Two-column desktop chamber layout */

@media (min-width: 900px) {

    #passages {
        max-width: 1200px;
    }

    .myst-room {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
        gap: 18px;
        align-items: start;
        max-width: 1200px;
    }

    .myst-parchment {
        grid-column: 1;
        grid-row: 1;
        border: 5px solid #705333;
        border-radius: 12px;
        padding: 24px;
        min-width: 0;
    }

    .myst-scene {
        grid-column: 2;
        grid-row: 1;
        border-radius: 12px;
        min-width: 0;
    }

}
/* PDD — Footer spans both desktop columns */
@media (min-width: 900px) {
    .myst-room-footer {
        grid-column: 1 / -1;
        grid-row: 2;
        width: 100%;
        box-sizing: border-box;
        text-align: center;
    }
}

