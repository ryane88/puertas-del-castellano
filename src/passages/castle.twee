:: PasadizoHipervinculos
<<nobr>>
<<castleDoorTitle "Pasadizo de Hipervínculos">>
<div class="room-card pdh-room">
    <p>Bienvenido al Pasadizo de Hipervínculos. Aquí encontrarás caminos hacia otros rincones del mundo hispanohablante.</p>
    <p id="pdh-status" role="status">Cargando enlaces…</p>
    <ul id="pdh-links" hidden></ul>
</div>
<<castleDoorReturn>>
<</nobr>>

<<done>>
<<run (async () => {
    const room = document.querySelector(".pdh-room");
    if (!room) return;
    const list = room.querySelector("#pdh-links");
    const status = room.querySelector("#pdh-status");
    const lifetime = new AbortController();
    $(document).one(":passageinit", () => lifetime.abort());

    try {
        const links = await setup.getPublishedLinks(lifetime.signal);
        if (lifetime.signal.aborted || !room.isConnected) return;

        for (const link of links) {
            if (typeof link?.title !== "string" || !link.title.trim() ||
                typeof link.url !== "string" || !/^https?:\/\/[^\s]+$/i.test(link.url)) continue;

            let url;
            try {
                url = new URL(link.url);
            } catch {
                continue;
            }
            if (url.protocol !== "https:" && url.protocol !== "http:") continue;

            const item = document.createElement("li");
            const anchor = document.createElement("a");
            anchor.href = url.href;
            anchor.target = "_blank";
            anchor.rel = "noopener noreferrer";
            anchor.textContent = link.title;
            item.append(anchor);

            if (typeof link.description === "string" && link.description.trim()) {
                const description = document.createElement("p");
                description.textContent = link.description;
                item.append(description);
            }
            list.append(item);
        }

        list.hidden = list.childElementCount === 0;
        status.textContent = list.hidden ? "Todavía no hay enlaces publicados. Vuelve pronto." : "";
    } catch {
        if (!lifetime.signal.aborted && room.isConnected) {
            status.textContent = "No se pudieron cargar los enlaces. Vuelve al castillo e inténtalo de nuevo.";
        }
    }
})()>>
<</done>>


:: PalacioDeObras

<<nobr>>
<<castleDoorTitle "Palacio de Obras">>
<section class="room-card pdo-room" lang="es">
    <p>Un misterio teatral para leer en voz alta · B1–B2 · 3–6 jugadores</p>
    <form class="pdo-start">
        <label for="pdo-scenario">Obra</label>
        <select id="pdo-scenario" name="scenario" required disabled></select>
        <label for="pdo-players">Número de jugadores</label>
        <select id="pdo-players" name="players">
            <option value="3" selected>3</option><option value="4">4</option>
            <option value="5">5</option><option value="6">6</option>
        </select>
        <button type="submit" disabled>Repartir los papeles</button>
        <button class="pdo-catalog-retry" type="button" hidden>Volver a cargar las obras</button>
    </form>
    <div class="pdo-play" hidden></div>
    <p class="pdo-status" role="status"></p>
    <button class="pdo-reset" type="button" hidden>Empezar otra partida</button>
</section>
<<castleDoorReturn>>
<</nobr>>

<<done>>
<<run setup.mountPdo(document.querySelector(".pdo-room"))>>
<</done>>


:: PilaDeLetras

<<nobr>>
<<castleDoorTitle "Pila de Letras">>
<section class="room-card pdl-room" lang="es">
    <p>Ordena las letras para descubrir la palabra. Juega a tu ritmo.</p>
    <div class="pdl-puzzle" hidden>
        <img class="pdl-art" alt="Ilustración de la palabra">
        <p class="pdl-letters" aria-live="polite"></p>
        <p><strong>Definición:</strong> <span class="pdl-definition"></span></p>
        <form>
            <label for="pdl-answer">Tu respuesta</label>
            <input id="pdl-answer" name="answer" type="text" autocomplete="off" autocapitalize="none" spellcheck="false">
            <div class="pdl-actions">
                <button type="submit">Comprobar</button>
                <button class="pdl-hint" type="button">Pista</button>
                <button class="pdl-visit" type="button">Visitar la sala</button>
            </div>
        </form>
    </div>
    <p class="pdl-status" role="status"></p>
    <button class="pdl-next" type="button" disabled>¿Otra?</button>
</section>
<<castleDoorReturn>>
<</nobr>>
