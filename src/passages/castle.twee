                State.variables.currentPdd = pdd;
                Engine.play("TestMystRoom");
            });

            line.appendChild(star);
            line.appendChild(link);
            roomsList.appendChild(line);
        });
    }

    filterButton.onclick = function () {
        favoritesOnly = !favoritesOnly;
        renderJournal();
    };

    renderJournal();
    journalPanel.hidden = false;
}); 
    journalClose.addEventListener("click", function () {
        journalPanel.hidden = true;
    });
}

const manuscriptButton = $("#myst-manuscript");

const chapterNumber = currentRoom
