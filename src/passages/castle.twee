:: PuertaPalabras {"position":"250,100","size":"100,100"}
<div class="room-card">
<h2>LA PUERTA DE LAS PALABRAS</h2>
<p>La puerta no tiene cerradura.</p>
<p>Sobre la piedra aparecen palabras que cambian lentamente, como si el castillo estuviera pensando.</p>
<p>Cuando acercas la mano, una de ellas comienza a brillar.</p>
<<link "Entrar">><<goto $latestPDD>><</link>>
<div class="castle-return">[[← Volver a la sala->Empieza]]</div>
</div>


:: StoryInit [startup] {"position":"50,250","size":"100,100"}
<<set $latestPDD = "PDD383">>

<<set $requestedPdd = null>>
<<set $favoritePdds = recall("pddFavorites", [])>>

<<run (() => {
    const params = new URLSearchParams(window.location.search);
    const pdd = params.get("pdd");

    if (pdd && /^\d+$/.test(pdd) && Number(pdd) > 0) {
        State.variables.requestedPdd = Number(pdd);
        State.variables.currentPdd = Number(pdd);
    }
})()>>

<<run console.log("StoryInit executed — requested PDD:", State.variables.requestedPdd)>>


:: TestCircularRoom {"position":"275,325","size":"100,100"}
<<nobr>>
<div class="room-card">
    <div class="pdd-kicker">
        LAS PUERTAS DEL CASTILLO
    </div>

    <h2 id="circular-room-title">
        Explorando el castillo...
    </h2>

    <div id="circular-content" style="
        display:grid;
        grid-template-columns:minmax(0, 1fr) minmax(0, 1fr);
        gap:24px;
        align-items:start;
        margin-top:24px;
        width:100%;
    ">

        <!-- LEFT: painting and description -->
        <div style="min-width:0;">
            <div id="circular-painting" class="pdd-image frame-1" hidden>
                <img id="circular-image" alt="">
            </div>

            <h3 id="circular-word"></h3>
            <div id="circular-description"></div>
        </div>

        <!-- RIGHT: doorway -->
        <div style="min-width:0; text-align:center;">
            <a id="circular-door" href="#" style="
                display:flex;
                align-items:center;
                justify-content:center;
                min-height:560px;
                padding:24px 15px;
                box-sizing:border-box;
                border:6px ridge #94734d;
                border-radius:75px 75px 8px 8px;
                background:linear-gradient(135deg,#65472d,#352417);
                color:#f6e5bf;
                font-size:1.25em;
                font-weight:bold;
                text-decoration:none;
                overflow-wrap:anywhere;
                text-align:center;
            ">
                Cargando puerta...
            </a>
        </div>

    </div>

    <div style="
        display:flex;
        justify-content:center;
        align-items:center;
        gap:18px;
        margin-top:24px;
    ">
        <button id="circular-prev" type="button">←</button>
        <span id="circular-counter"></span>
        <button id="circular-next" type="button">→</button>
    </div>

    <div id="circular-status" style="margin-top:16px;"></div>
</div>
<!-- PUERTAS DEL CASTELLANO — MANUSCRIPT PROTOTYPE -->

<div id="pdd-manuscript-trigger" style="text-align:center;margin:20px 0;" hidden>
    <button id="pdd-open-manuscript" type="button">
        📜 Examinar el manuscrito
    </button>
</div>

<div id="pdd-manuscript-overlay" hidden>
    <div id="pdd-manuscript-paper">
        <button id="pdd-close-manuscript" type="button"
                aria-label="Cerrar manuscrito">✕</button>

        <div class="pdd-manuscript-heading">CAPÍTULO 77</div>

        <h2>La libertad también sabe regresar</h2>

        <p>En Tarifa, Rosita y Ricardo comenzaron a hacer las maletas.</p>

        <p>Aquella misma mañana, con el
<a href="#" class="pdd-manuscript-word" data-pdd="385">albor</a>,
esa primera claridad que anuncia el día antes de que salga
completamente el sol, abandonaron Tarifa.</p>

        <p>Pero mientras una historia terminaba, otra comenzaba.</p>

        <p>En Granada aterrizaban Balance y Cifras...</p>
    </div>
</div>
<</nobr>>
<<done>>
<<run (async function () {
    const currentPdd = Number(State.variables.currentPdd || 49);

    const title = $("#circular-room-title");
    const door = $("#circular-door");
    const painting = $("#circular-painting");
    const image = $("#circular-image");
    const word = $("#circular-word");
    const description = $("#circular-description");
    const counter = $("#circular-counter");
    const status = $("#circular-status");

    try {
        const currentRoom = await setup.getRoom(currentPdd);
        

        if (!currentRoom) {
            title.text("Sala no encontrada");
            return;
        }

    title.text("Sala PDD " + currentPdd + " — " + currentRoom.word);

        const connections = await setup.getConnections(currentPdd);

        const destinations = connections.map(function(c) {
            return Number(c.from_pdd) === currentPdd
                ? Number(c.to_pdd)
                : Number(c.from_pdd);
        });

        const rooms = await setup.getPublishedRooms(destinations);

        const availableDoors = connections
            .map(function(c) {
                const destination =
                    Number(c.from_pdd) === currentPdd
                        ? Number(c.to_pdd)
                        : Number(c.from_pdd);

                const room = rooms.find(function(r) {
                    return Number(r.pdd) === destination;
                });

                return room
                    ? { room: room, connection: c }
                    : null;
            })
            .filter(Boolean);

        availableDoors.sort(function(a, b) {
            return (
                Number(b.connection.featured) -
                    Number(a.connection.featured) ||
                Number(b.connection.strength || 0) -
                    Number(a.connection.strength || 0) ||
                Number(a.room.pdd) - Number(b.room.pdd)
            );
        });

        // For now, show every published connection.
        // Progressive unlocking comes later.
 
        // Add chronological neighbors to the circular room.
      
        // Get previous and next published PDDs.
        const chronological =
            await setup.getChronologicalNeighbors(currentPdd);

let previous = chronological.previous;
let next = chronological.next;

const latestNumber = Number(
    await setup.getLatestPublishedPdd()
);

// Close the chronological loop in both directions.
if (currentPdd === 1 && !previous && latestNumber > 1) {
    previous = await setup.getRoom(latestNumber);
}

if (currentPdd === latestNumber && !next && latestNumber > 1) {
    next = await setup.getRoom(1);
}

// Connect PDD 1 backward to the latest published PDD.
if (!previous && currentPdd === 1) {
    const latestNumber = Number(
        await setup.getLatestPublishedPdd()
    );

    if (latestNumber > 1) {
        previous = await setup.getRoom(latestNumber);
    }
}

        const enteredFromPdd =
            Number(State.variables.enteredFromPdd || 0);

        // Keep semantic doors, excluding chronological
        // neighbors to prevent duplicates.
        const semanticDoors = availableDoors.filter(function(item) {
            return Number(item.room.pdd) !== Number(previous?.pdd)
                && Number(item.room.pdd) !== Number(next?.pdd);
        });

        // Set aside the entrance door, if present.
        const returnIndex = semanticDoors.findIndex(function(item) {
            return Number(item.room.pdd) === enteredFromPdd;
        });

        const returnDoor = returnIndex >= 0
            ? semanticDoors.splice(returnIndex, 1)[0]
            : null;

        // Semantic doors are already sorted by featured
        // status and connection strength.
        const bestSemantic = semanticDoors.shift() || null;

        const circularDoors = [];

        if (bestSemantic) {
            // Front: strongest semantic connection.
            circularDoors.push(bestSemantic);

            // Right: previous PDD.
            if (previous) {
                circularDoors.push({
                    room: previous,
                    type: "previous"
                });
            }

            // Remaining semantic doors.
            const midpoint = Math.ceil(semanticDoors.length / 2);

            circularDoors.push(...semanticDoors.slice(0, midpoint));

            // Back: return door.
            if (returnDoor) {
                circularDoors.push(returnDoor);
            }

            circularDoors.push(...semanticDoors.slice(midpoint));

            // Left: next PDD.
            if (next) {
                circularDoors.push({
                    room: next,
                    type: "next"
                });
            }

        } else {
            // No other semantic connections:
            // face the next PDD, or previous if next is absent.
            if (next) {
                circularDoors.push({
                    room: next,
                    type: "next"
                });
            }

            if (returnDoor) {
                circularDoors.push(returnDoor);
            }

            if (previous) {
                circularDoors.push({
                    room: previous,
                    type: "previous"
                });
            }
        }

        // Replace door list without changing navigation handlers.
        availableDoors.splice(
            0,
            availableDoors.length,
            ...circularDoors
        );

        // Always face the first door in the arranged circle.
        let selectedIndex = 0;

        function showWall() {
            if (!availableDoors.length) {
                door.text("No hay puertas disponibles");
                door.removeAttr("href");
                painting.prop("hidden", true);
                word.empty();
                description.empty();
                counter.text("0 / 0");
                return;
            }

            const selected = availableDoors[selectedIndex];
            const room = selected.room;
            meaningRoom = selected.type === "exit" ? null : room;

           
            // Distinguish chronological doors.
            const isTimeDoor =
                selected.type === "previous" ||
                selected.type === "next";

            door.toggleClass("time-door", isTimeDoor);

            if (selected.type === "previous") {
                door.text("⌛ La palabra anterior");
            } else if (selected.type === "next") {
                door.text("⌛ La palabra siguiente");
            } else {
                door.text("Más allá de esta palabra");
            }

           // PDD WORD REVEAL — hide the answer on every wall change.
word.stop(true, true)
    .text("¿Qué palabra soy?")
    .css("cursor", "pointer")
    .attr("title", "Revelar palabra")
    .off("click.pddReveal")
    .one("click.pddReveal", function () {
        word.fadeOut(150, function () {
            word.text(room.word).fadeIn(350);
        });
    });

description.text(room.description || "");

            const frameNumber = Number(room.pdd) % 3;

            painting
                .removeClass("frame-0 frame-1 frame-2")
                .addClass("frame-" + frameNumber);

            const imagePath = "images/pdd" + room.pdd + ".jpg";
            const fallbackPath = "images/pdd-placeholder.jpg";

            image
                .off("error")
                .one("error", function() {
                    $(this).off("error");
                    this.src = fallbackPath;
                })
                .attr("alt", room.word)
                .attr("src", imagePath);

            painting.prop("hidden", false);

            counter.text(
                (selectedIndex + 1) + " / " + availableDoors.length
            );
        }

        // Animate turning between walls.
        const circularContent = $("#circular-content");
        let isTurning = false;

        function turnWall(direction) {
            if (isTurning || availableDoors.length < 2) return;

            const outClass = "turn-out-" + direction;
            const inClass = "turn-in-" + direction;

            isTurning = true;

            circularContent.removeClass(
                "turn-out-left turn-out-right " +
                "turn-in-left turn-in-right"
            );

            circularContent.addClass(outClass);

            setTimeout(function() {
                selectedIndex = direction === "left"
                    ? (selectedIndex - 1 + availableDoors.length)
                        % availableDoors.length
                    : (selectedIndex + 1)
                        % availableDoors.length;

                showWall();

                circularContent
                    .removeClass(outClass)
                    .addClass(inClass);

                setTimeout(function() {
                    circularContent.removeClass(inClass);
                    isTurning = false;
                }, 280);

            }, 220);
        }

 $("#circular-prev").on("click", function() {
    turnWall("left");
});

$("#circular-next").on("click", function() {
    turnWall("right");
});
        door.on("click", function(event) {
            event.preventDefault();

            if (!availableDoors.length) return;

            const selected = availableDoors[selectedIndex];

		State.variables.enteredFromPdd = currentPdd;
		State.variables.currentPdd = Number(selected.room.pdd);
		Engine.play("TestMystRoom");
        });

        showWall();

    } catch (error) {
        console.error("Circular room error:", error);
        status.text("Error al cargar las puertas.");
    }
})()>>
