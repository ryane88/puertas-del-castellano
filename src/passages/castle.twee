<<run (function () {

    $("#solo-view-diary").on("click", function () {

        const journal = JSON.parse(
            localStorage.getItem("soloCastleJournal") || "[]"
        );

        const container = $("#solo-diary-entries");
        container.empty();

        if (journal.length === 0) {
            container.text("Todavía no hay recuerdos.");
        }

        journal.forEach(function (entry, index) {
            const section = $("<div>").addClass("solo-diary-entry");

            $("<h4>")
                .text((index + 1) + ". " + entry.title)
                .appendTo(section);

            $("<p>")
                .text(entry.text)
                .css("white-space", "pre-line")
                .appendTo(section);

            container.append(section);
        });

        $("#solo-diary-view").prop("hidden", false);
    });

    $("#solo-close-diary").on("click", function () {
        $("#solo-diary-view").prop("hidden", true);
    });

})()>>
