    <<run (async function () {
        const currentPdd = State.variables.currentPdd || 49;
        const container = $("#test-connections");

        container.text("Buscando puertas abiertas...");

        try {
            const connections =
                await setup.getConnections(currentPdd);

            const destinations = connections.map(function(c) {
                return c.from_pdd === currentPdd
                    ? c.to_pdd
                    : c.from_pdd;
            });

  
const rooms =
    await setup.getPublishedRooms(destinations);

// Match each published room to its corridor.
const availableDoors = connections
    .map(function(c) {
        const destination =
            c.from_pdd === currentPdd
                ? c.to_pdd
                : c.from_pdd;

        const room = rooms.find(function(r) {
            return r.pdd === destination;
        });

        return room
            ? { room: room, connection: c }
            : null;
    })
    .filter(Boolean);

// Always prioritize featured and strong connections.
// Use PDD number to break ties consistently.
availableDoors.sort(function(a, b) {
    return (
        Number(b.connection.featured) -
            Number(a.connection.featured) ||
        Number(b.connection.strength || 0) -
            Number(a.connection.strength || 0) ||
        a.room.pdd - b.room.pdd
    );
});

// Display at most six doors.
const visibleDoors = availableDoors.slice(0, 6);

container.empty();


if (rooms.length === 0) {
    container.text(
        "No hay otras puertas abiertas todavía."
    );
}

          visibleDoors.forEach(function(item) {
    const room = item.room;
                const door = $("<a>", {
