<<run (async function () {

    const kicker = $("#myst-kicker");
    const word = $("#myst-word");
    const description = $("#myst-description");
const meaningButton = $("#myst-meaning");
const meaningQuiz = $("#myst-meaning-quiz");
const meaningChoices = $("#myst-meaning-choices");
const meaningFeedback = $("#myst-meaning-feedback");

let meaningRoom = null;

meaningButton.on("click", async function () {
    if (!meaningRoom) return;

    meaningButton.prop("hidden", true);
    meaningQuiz.prop("hidden", false);
    meaningChoices.empty();
    meaningFeedback.text("Buscando definiciones...");

    try {
        const correct = (meaningRoom.short_definition || "").trim();

        if (!correct) {
            meaningFeedback.text("Esta palabra todavía no tiene definición.");
            return;
        }

        const endpoint = setup.supabase.url +
            "/rest/v1/rooms?select=pdd,short_definition" +
            "&published=eq.true" +
            "&short_definition=not.is.null" +
            "&pdd=neq." + Number(meaningRoom.pdd) +
            "&limit=1000";

        const response = await fetch(endpoint, {
            headers: { apikey: setup.supabase.key }
        });

        if (!response.ok) {
            throw new Error("Definitions error: " + response.status);
        }

        const otherRooms = await response.json();

        const distractors = otherRooms
            .map(function (room) {
                return (room.short_definition || "").trim();
            })
            .filter(function (definition) {
                return definition && definition !== correct;
            });

        // Shuffle the distractors.
        distractors.sort(function () {
            return Math.random() - 0.5;
        });

        const choices = [correct, ...new Set(distractors)].slice(0, 3);

        if (choices.length < 3) {
            meaningFeedback.text("Necesitamos tres definiciones para jugar.");
            return;
        }

        // Shuffle the three choices.
        for (let i = choices.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [choices[i], choices[j]] = [choices[j], choices[i]];
        }

        meaningFeedback.empty();

        choices.forEach(function (definition) {
            const button = $("<button>", {
                type: "button",
                text: definition
            });

            button.css({
                display: "block",
                width: "100%",
                margin: "10px 0",
                textAlign: "left",
                whiteSpace: "normal"
            });

            button.on("click", function () {
                if (definition === correct) {
                    meaningFeedback.text("¡Correcto!");
                    meaningChoices.find("button").prop("disabled", true);
                } else {
                    meaningFeedback.text("Inténtalo otra vez.");
                }
            });

            meaningChoices.append(button);
        });

    } catch (error) {
        console.error("Meaning quiz error:", error);
        meaningFeedback.text("No se pudieron cargar las definiciones.");
    }
});

    const image = $("#myst-pdd-image");
    // PDD Painting Gallery
