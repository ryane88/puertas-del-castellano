    "Direction:", travelDirection,
    "Doors:", circularDoors.map(function (d) {
        return d.room.pdd + " (" + (d.type || "semantic") + ")";
    })
);
            if (!circularDoors.length) {
                kicker.text("PDD " + currentPdd);
                word.text("No hay puertas disponibles");
                description.empty();
                counter.text("0 / 0");
                image.attr("src", "images/pdd-placeholder.jpg");
                enterButton.prop("disabled", true);
                return;
            }
meaningRoom = null;
meaningButton.prop("hidden", true);
meaningQuiz.prop("hidden", true);
meaningChoices.empty();
meaningFeedback.empty();
            const selected = circularDoors[selectedIndex];
            const room = selected.room;
            // Update the painting gallery for the selected door.
gallery.prop("hidden", true);

$("#myst-gallery-image").attr(
    "src",
