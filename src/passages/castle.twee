<<run (async function () {
    try {
        const currentPrompt = Number(
            localStorage.getItem("soloCastleCurrentPrompt") || 0
        );

        const currentVisit = Number(
            localStorage.getItem("soloCastleCurrentVisit") || 1
        );

        // Database has a maximum of three visits per prompt.
        const promptVisit = currentPrompt === 0
            ? 1
            : Math.min(currentVisit, 3);

        const url = setup.supabase.url +
            "/rest/v1/solo_prompts" +
            "?prompt_id=eq." + currentPrompt +
            "&visit=eq." + promptVisit +
            "&select=*";

        const response = await fetch(url, {
            headers: {
                apikey: setup.supabase.key
            }
        });

        if (!response.ok) {
            throw new Error("HTTP " + response.status);
        }

        const prompts = await response.json();
        const prompt = prompts[0];

        if (!prompt) {
            throw new Error("Prompt not found");
        }

        $("#solo-title").text(
    "Prompt " + currentPrompt +
    " — " + prompt.title +
    " (Visita " + currentVisit + ")"
);

        $("#solo-prompt")
            .text(prompt.prompt_text)
            .css("white-space", "pre-line");

        // Display the painting assigned in Supabase.
        if (prompt.image) {
            $("#solo-image").attr("src", "images/" + prompt.image);
            $("#solo-scene").prop("hidden", false);
        } else {
            $("#solo-scene").prop("hidden", true);
        }

    } catch (error) {
        console.error("Solo castle error:", error);
        $("#solo-status").text(
            "No se pudo cargar la aventura."
        );
    }
})()>>



