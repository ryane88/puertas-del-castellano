            </svg>
            <span class="pdp-destination" aria-live="polite" aria-atomic="true"></span>
        </div>
        <div class="pdp-choices" role="group" aria-label="Puentes de esta isla">
            <div class="pdp-turns">
                <button type="button" data-pdp-action="left" aria-label="Girar a la izquierda">↶ Izquierda</button>
                <button type="button" data-pdp-action="cross">Cruzar</button>
                <button type="button" data-pdp-action="right" aria-label="Girar a la derecha">Derecha ↷</button>
            </div>
            <p class="pdp-facing"></p>
        </div>
        <p class="pdp-complete" hidden>¡Frase completa!</p>
        <div class="pdp-actions" role="group" aria-label="Recorrido de la frase">
            <button type="button" data-pdp-action="back">← Volver a la isla anterior</button>
            <button type="button" data-pdp-action="restart">Empezar de nuevo en Yo</button>
        </div>
    </div>
</section>
<<castleDoorReturn>>
<</nobr>>
