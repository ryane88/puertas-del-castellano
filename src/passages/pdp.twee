                </g>
                <path fill="#a7653b" stroke="#714329" stroke-width="3" d="M36 326q39-32 99-25 26-15 65-8 29-22 77-17 82-13 154 0 63-5 99 17 39-6 67 8 53-6 88 25l-27 24H62z"/>
