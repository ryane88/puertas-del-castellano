                    <path fill="#39852f" d="M222 152q48 18 95 12 24 12 58 7 30 5 56-8 33 2 69-15l-5 15q-34 20-66 14-28 13-56 6-35 7-58-5-52 7-88-12z"/>
                    <path fill="#90d742" stroke="#417b32" stroke-width="3" d="M221 152q0-20 41-32 90-22 186-4 47 10 52 33-37 17-70 14-27 12-57 7-34 5-57-7-52 7-95-11z"/>
