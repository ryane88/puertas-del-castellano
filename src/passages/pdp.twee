:: PDP
<<nobr>>
<<castleDoorTitle "Puentes de Principiante">>
<section class="pdp-room" aria-label="Puentes de Principiante">
    <p class="pdp-status" role="status">Cargando las islas…</p>
    <button type="button" class="pdp-retry" hidden>Reintentar</button>
    <div class="pdp-game" hidden>
        <p class="pdp-sentence" tabindex="-1"></p>
        <div class="pdp-view">
            <svg class="pdp-scene" viewBox="0 0 720 350" aria-hidden="true" focusable="false">
                <g fill="#fffdf7" stroke="#d2effb" stroke-width="3">
