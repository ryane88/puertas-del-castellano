{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🏰 Watch Castle",
      "type": "shell",
      "command": "./tools/tweego/tweego",
      "args": [
        "-w",
        "-o",
        "index.html",
        "src"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}